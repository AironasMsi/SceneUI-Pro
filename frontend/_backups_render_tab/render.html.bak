<div id="tab-render" class="content hidden">

  <div style="display: grid; grid-template-columns: 380px 1fr; gap: 16px; height: calc(100vh - 120px); min-height: 650px;">

    <!-- LEFT PANEL: RENDER CONTROLS & SETTINGS -->
    <div class="panel flex-col" style="gap: 12px; height: 100%; overflow-y: auto; margin-bottom: 0; padding: 14px;">
      
      <!-- TOP SUMMARY CARD -->
      <div style="background: rgba(0, 255, 204, 0.05); border: 1px solid rgba(0, 255, 204, 0.2); border-radius: 10px; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
        <div class="flex justify-between items-start text-xs">
          <span class="text-muted" style="min-width: 90px;">Garsas ir Įgarsinimas:</span>
          <span id="renderAudioStatus" style="color: var(--good, #00ffcc); font-weight: 700; text-align: right; word-break: break-all;">✅ Voiceover prijungtas</span>
        </div>
        <div class="flex justify-between items-center text-xs" style="border-top: 1px solid rgba(255,255,255,0.05); padding-top: 6px;">
          <span class="text-muted">Projekto Scenos:</span>
          <strong id="renderSceneCount" style="color: var(--accent-secondary, #00ffcc);">0 scenų</strong>
        </div>
        <div class="flex justify-between items-center text-xs">
          <span class="text-muted">Prognozuojama Trukmė:</span>
          <strong id="renderEstDuration" class="mono" style="color: #fff; font-size: 13px;">00:00.0</strong>
        </div>
      </div>

      <!-- RENDER ENGINE SELECTOR -->
      <div class="field" style="margin-bottom: 12px;">
        <label style="font-size: 11px; text-transform: uppercase; color: #38bdf8; font-weight: 800; display:flex; justify-content:space-between; align-items:center;">
          <span>🚀 RENDERIO VARIKLIS (ENGINE)</span>
          <span style="font-size:9px; color:#4ade80; background:rgba(74,222,128,0.15); padding:2px 6px; border-radius:4px;">0 Noise • 100% Smooth</span>
        </label>
        <select id="renderEngineSelect" style="font-size: 12px; font-weight: 700; background: rgba(56, 189, 248, 0.12); border: 1px solid rgba(56, 189, 248, 0.45); color: #bae6fd;">
          <option value="ffmpeg_pro" selected>⚡ FFmpeg Pro Master Engine (Lanczos 18-CRF High-Res, Pilna Trukmė) [Rekomenduojama]</option>
          <option value="web_canvas">🌐 Web Canvas Engine (GPU Naršyklė)</option>
        </select>
      </div>

      <!-- RESOLUTION & FPS CODEC 2-COLUMN GRID -->
      <div class="grid-wf" style="grid-template-columns: 1fr 1fr; gap: 8px;">
        <div class="field" style="margin: 0;">
          <label style="font-size: 10px; text-transform: uppercase; color: var(--muted); font-weight: 700;">REZOLIUCIJA</label>
          <select id="renderResSelect" style="font-size: 11px; padding: 6px 8px; font-weight: 600;">
            <option value="1920x1080" selected>1080p FHD (16:9)</option>
            <option value="1080x1920">1080x1920 Shorts (9:16)</option>
            <option value="2560x1440">1440p 2K QHD</option>
            <option value="3840x2160">2160p 4K UHD</option>
          </select>
        </div>

        <div class="field" style="margin: 0;">
          <label style="font-size: 10px; text-transform: uppercase; color: var(--muted); font-weight: 700;">FPS IR KODEKAS</label>
          <select id="renderFpsCodecSelect" style="font-size: 11px; padding: 6px 8px; font-weight: 600;">
            <option value="30_h264" selected>30 FPS (H.264 MP4)</option>
            <option value="60_h264">60 FPS (H.264 MP4)</option>
            <option value="30_h265">30 FPS (H.265 HEVC)</option>
            <option value="24_prores">24 FPS (ProRes HQ)</option>
          </select>
        </div>
      </div>

      <!-- SCENE & EFFECTS OVERVIEW BUTTON -->
      <button id="btnOpenSceneOverview" type="button" class="btn" style="background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.4); color: #7dd3fc; padding: 10px 14px; font-weight: 750; font-size: 12px; justify-content: center; width: 100%; gap: 8px; border-radius: 8px; cursor: pointer; transition: all 0.2s ease;" onclick="if(typeof window.openSceneOverviewModal==='function') window.openSceneOverviewModal();">
        📋 Scenų ir Efektų Suvestinė (Peržiūrėti / Keisti)...
      </button>

      <!-- PROMINENT EFEKTŲ IR PERĖJIMŲ BIBLIOTEKA BUTTON -->
      <button id="btnOpenEffectsGallery" class="btn" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #db2777 100%); border: none; color: #ffffff; padding: 11px 14px; font-weight: 800; font-size: 12px; justify-content: center; width: 100%; gap: 10px; border-radius: 8px; box-shadow: 0 4px 20px rgba(124, 58, 237, 0.45); cursor: pointer; transition: all 0.2s ease;" onclick="document.getElementById('modalEffectsLibrary').classList.add('show');">
        ✨ 🎨 Efektų ir Perėjimų Biblioteka...
      </button>

      <!-- MOTION & CAMERA EFFECTS (KEN BURNS) -->
      <div class="field">
        <label style="font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 700;">KAMEROS JUDĖJIMAS (KEN BURNS CAMERA MOTION)</label>
        <select id="renderKenBurnsSelect" style="font-size: 12px; font-weight: 600;">
          <option value="constant_speed" selected>⚡ Constant Uniform Zoom-In (Vienodas Pastovus Greitis - trumpesnė mažiau, ilgesnė daugiau)</option>
          <option value="constant_speed_out">⚡ Constant Uniform Zoom-Out (Vienodas Pastovus Tolimas)</option>
          <option value="cinematic">🎯 Cinematic Smooth Zoom-In (Glotnus Švelnėjantis Priartėjimas)</option>
          <option value="zoom_out">🔍 Center Zoom-Out Reveal (Tolimas nuo Vidurio)</option>
          <option value="zoom_in_out">🔄 Center Pulse Zoom (Priartėjimas ir Tolimas)</option>
          <option value="pan_left">⬅️ Pan Left (Slinkimas į Kairę)</option>
          <option value="pan_right">➡️ Pan Right (Slinkimas į Dešinę)</option>
          <option value="pan_up">⬆️ Pan Up (Slinkimas į Viršų)</option>
          <option value="pan_down">⬇️ Pan Down (Slinkimas į Apačią)</option>
          <option value="drift">💫 Cinematic Drift (Švelnus Dreifavimas)</option>
          <option value="random">🌀 Random Smart Motion (Kiekvienai Scenai Skirtingas)</option>
          <option value="disabled">🚫 Išjungta (Statiškas Vaizdas)</option>
        </select>
      </div>

      <!-- CAMERA MOTION INTENSITY -->
      <div class="field">
        <div class="flex justify-between items-center">
          <label style="font-size: 10px; text-transform: uppercase; color: var(--muted); font-weight: 700;">KAMEROS JUDĖJIMO INTENSYVUMAS</label>
          <span id="renderKenBurnsVal" class="mono text-xs" style="color: var(--accent-secondary, #00ffcc); font-weight: 700;">15%</span>
        </div>
        <input type="range" id="renderKenBurnsInput" min="5" max="40" value="15" />
      </div>

      <!-- TRANSITIONS -->
      <div class="field">
        <label style="font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 700;">PERĖJIMAI TARP SCENŲ (TRANSITIONS)</label>
        <select id="renderTransitionSelect" style="font-size: 12px; font-weight: 600;">
          <option value="cut">✂️ Švarus Kadrų Kirpimas (Direct Cut - Be perėjimo)</option>
          <option value="dissolve" selected>🌊 Cross Dissolve (Sklandus Švelnus Susiliejimas)</option>
          <option value="fade_black">🌑 Fade to Black (Apsitemdymas per Juodą)</option>
          <option value="fade_white">⚪ Fade to White (Blyksnis per Baltą)</option>
          <option value="slide_left">⬅️ Slide Left (Slinkimas į Kairę)</option>
          <option value="slide_right">➡️ Slide Right (Slinkimas į Dešinę)</option>
          <option value="slide_up">⬆️ Slide Up (Slinkimas į Viršų)</option>
          <option value="slide_down">⬇️ Slide Down (Slinkimas į Apačią)</option>
          <option value="smooth_left">💨 Smooth Slide Left (Glotnus Slydimas)</option>
          <option value="wipe_left">🪟 Wipe Left (Nuvalymas iš Dešinės į Kairę)</option>
          <option value="wipe_right">🪟 Wipe Right (Nuvalymas iš Kairės į Dešinę)</option>
          <option value="circle_crop">⭕ Circle Iris Crop (Apskritimo Perėjimas)</option>
          <option value="circle_open">⭕ Circle Open (Apskritimo Atsidarymas)</option>
          <option value="radial">🕒 Radial Clock Wipe (Laikrodžio Rodyklė)</option>
          <option value="zoom_in">🔭 Zoom In Push (Šuolis į Priekį)</option>
          <option value="pixelize">👾 Pixelize / Mosaic (Pikselių Mozaika)</option>
          <option value="vert_open">🚪 Vertical Blinds Open (Vertikalios Žaliuzės)</option>
          <option value="horz_open">🚪 Horizontal Blinds Open (Horizontalios Žaliuzės)</option>
        </select>
      </div>

      <!-- TRANSITION DURATION SLIDER -->
      <div class="field">
        <div class="flex justify-between items-center">
          <label style="font-size: 10px; text-transform: uppercase; color: var(--muted); font-weight: 700;">PERĖJIMO TRUKMĖ (TRANSITION DURATION)</label>
          <span id="renderTransitionDurVal" class="mono text-xs" style="color: var(--accent-secondary, #00ffcc); font-weight: 700;">0.6s</span>
        </div>
        <input type="range" id="renderTransitionDurInput" min="0.1" max="1.5" step="0.1" value="0.6" />
      </div>

      <!-- COLOR GRADING & FILTERS -->
      <div class="field">
        <label style="font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 700;">KOLORISTIKA IR VAIZDO FILTRAI (COLOR GRADING)</label>
        <select id="renderColorFilterSelect" style="font-size: 12px; font-weight: 600;">
          <option value="none" selected>📷 Original (Natūralios AI Spalvos)</option>
          <option value="teal_orange">🌆 Cinematic Teal & Orange (Hollywood Blokbasteris)</option>
          <option value="vintage">🎞️ Vintage 35mm Film (Juostos Grūdas ir Šiluma)</option>
          <option value="bw_contrast">🕶️ Noir High-Contrast B&W (Juodai Balta Drama)</option>
          <option value="golden_hour">🌅 Warm Golden Hour (Auksinis Saulėlydis)</option>
          <option value="cyberpunk">🏙️ Cyberpunk Neon Night (Neoninis Kontrastas)</option>
          <option value="cold_blue">❄️ Cold Matrix / Sci-Fi Blue (Kiber Mėlynas)</option>
          <option value="vivid_hdr">💎 Vivid HDR Boost (Ryškus Kontrastas ir Sodrumas)</option>
        </select>
      </div>

      <!-- ZOOM SPEED MODE -->
      <div class="field">
        <label style="font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 700;">PRIARTĖJIMO REŽIMAS (ZOOM SPEED MODE)</label>
        <select id="renderZoomModeSelect" style="font-size: 12px; font-weight: 600;">
          <option value="constant_speed" selected>⚡ Vienodas Greitis Visoms Scenoms (Constant Rate/Sec)</option>
          <option value="constant_total">🎯 Vienodas Galutinis Priartėjimas (Constant Target %)</option>
        </select>
      </div>

      <!-- SUBTITLES & TEXT OVERLAYS -->
      <div class="field">
        <label style="font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 700;">SUBTITRAI IR TEKSTAI (SUBTITLES OVERLAY)</label>
        <select id="renderSubtitleModeSelect" style="font-size: 12px; font-weight: 600;">
          <option value="none" selected>🚫 Be Subtitrų (Clean Video)</option>
          <option value="whisper_yellow">🟨 Whisper Subtitrai (Geltoni su Šešėliu)</option>
          <option value="whisper_box">⬛ Whisper Subtitrai (Juodas Fonas)</option>
          <option value="whisper_neon">💡 Whisper Subtitrai (Neoninis Švytėjimas)</option>
          <option value="kinetic_titles">🎬 Title Cards + Kinetic Text</option>
        </select>
      </div>

      <!-- BACKGROUND MUSIC (BGM TRACK) -->
      <div class="field">
        <div class="flex justify-between items-center mb-1">
          <label style="font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 700;">FONINĖ MUZIKA (BGM TRACK)</label>
          <input type="file" id="bgmFileInput" accept="audio/*" class="hidden" />
          <button id="btnSelectBgm" class="btn text-xs" style="padding: 3px 8px; font-weight: 700;">🎵 Įkelti MP3</button>
        </div>
        <div class="flex items-center" style="gap: 8px;">
          <span id="bgmFileName" class="text-xs text-muted flex-1" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Nepasirinkta foninė muzika</span>
          <span id="renderBgmVolVal" class="mono text-xs" style="color: var(--accent-secondary, #00ffcc); font-weight: 700;">15%</span>
        </div>
        <input type="range" id="renderBgmVolInput" min="0" max="50" value="15" style="margin-top: 4px;" />
      </div>

      <div style="height: 1px; background: var(--border, #28283a); margin: 4px 0;"></div>

      <!-- AUTO-PLAY TOGGLE -->
      <div class="field" style="margin: 2px 0 8px 0;">
        <label class="flex items-center text-xs cursor-pointer" style="color: var(--muted); user-select: none;">
          <input type="checkbox" id="renderAutoPlayCheckbox" style="margin-right: 8px; cursor: pointer;" />
          <span>▶️ Automatiškai paleisti sugeneravus (Auto-Play)</span>
        </label>
      </div>

      <!-- ACTION BUTTONS -->
      <button id="btnStartFinalRender" class="btn primary" style="padding: 12px; font-weight: 800; font-size: 14px; justify-content: center; width: 100%; cursor: pointer;" onclick="if(typeof window.startFinalVideoRender==='function') window.startFinalVideoRender();">
        🚀 Renderinti Pilną Video (.mp4)
      </button>

      <div class="flex justify-between items-center" style="gap: 8px; margin-top: 6px;">
        <button id="btnExportDavinciPackage" class="btn" style="flex: 1; padding: 10px 14px; font-weight: 800; font-size: 12px; background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%); color:#fff; border:none; box-shadow: 0 2px 12px rgba(236,72,153,0.35); justify-content:center; cursor: pointer;" title="Eksportuoti pilną DaVinci Resolve ZIP paketą su medija, XML timeline, subtitrais ir buferiais" onclick="if(typeof window.exportDavinciResolvePackage==='function') window.exportDavinciResolvePackage();">
          🎬 DaVinci Resolve ZIP Paketas (su Medija ir XML)
        </button>
      </div>

    </div>

    <!-- RIGHT PANEL: RENDER PREVIEW & LOG MONITOR -->
    <div class="flex-col" style="gap: 16px; height: 100%; overflow: hidden;">
      
      <!-- Video Player & Preview -->
      <div class="panel flex-col items-center justify-center" style="flex: 1; min-height: 380px; position: relative; background: radial-gradient(circle at center, #141420 0%, #06060a 100%); padding: 16px; overflow: hidden; margin-bottom: 0;">
        
        <div id="renderVideoContainer" class="canvas-container" style="position: relative; max-width: 100%; max-height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; width: 100%;">
          
          <div id="renderPlaceholder" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 12px;">
            <div style="font-size: 48px; opacity: 0.6;">🎬</div>
            <h3 style="margin: 0; color: var(--text-main, #fff);">Galutinio Video Renderinimas</h3>
            <p class="text-muted text-xs" style="max-width: 400px; margin: 0;">
              Spauskite <strong>"Renderinti Pilną Video"</strong>, kad FFmpeg sujungtų visas scenas, įgarsinimą, kinetic tekstus ir foninę muziką į aukštos kokybės .mp4 video failą.
            </p>
          </div>

          <video id="finalRenderVideoPlayer" controls class="hidden" style="max-width: 100%; max-height: 52vh; border-radius: 8px; box-shadow: 0 10px 40px rgba(0,0,0,0.8); border: 1px solid var(--border);"></video>

        </div>

        <!-- Render Progress Bar -->
        <div id="renderProgressArea" class="hidden" style="width: 100%; max-width: 550px; margin-top: 16px; background: rgba(15, 15, 25, 0.9); padding: 12px 16px; border-radius: 12px; border: 1px solid var(--border);">
          <div class="flex justify-between items-center text-xs mb-2">
            <span id="renderProgressStatus" style="font-weight: bold; color: var(--accent-secondary, #00ffcc);">⚡ Renderinama... 0%</span>
            <span id="renderProgressTime" class="mono text-muted">00:00</span>
          </div>
          <div class="progress-container" style="height: 10px; background: rgba(255,255,255,0.1); border-radius: 6px; overflow: hidden;">
            <div id="renderProgressFill" class="progress-fill" style="width: 0%; height: 100%; background: linear-gradient(90deg, #00ffcc, #0099ff); transition: width 0.3s ease;"></div>
          </div>
        </div>

      </div>

      <!-- Render Log / Command Terminal Monitor -->
      <div class="panel flex-col" style="height: 200px; margin-bottom: 0; padding: 12px;">
        <div class="panel-h justify-between items-center" style="margin-bottom: 6px;">
          <span>🖥️ FFmpeg Renderinimo Žurnalas (Logs)</span>
          <button id="btnClearRenderLog" class="btn text-xs icon" style="padding: 2px 6px;">🧹</button>
        </div>
        <div id="renderLogOutput" class="mono text-xs" style="flex: 1; background: #030306; border: 1px solid var(--border); border-radius: 6px; padding: 10px; overflow-y: auto; color: #00ffcc; font-family: monospace; white-space: pre-wrap; line-height: 1.4;">
[System Ready] FFmpeg 8.1.2 Studio Engine Initialized. Ready to composite project media.
        </div>
      </div>

    </div>

  </div>

</div>
