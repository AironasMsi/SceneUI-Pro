<!-- DEMO SHOWCASE MODAL                                                          -->
<!-- ============================================================================ -->
<div id="modalDemoShowcase" class="modal-overlay">
  <div class="modal" style="max-width: 1050px; width: 95vw; max-height: 90vh; display: flex; flex-direction: column; background: var(--panel); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.8);">
    
    <div class="modal-h" style="padding: 16px 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; background: rgba(20, 26, 40, 0.95);">
      <div style="display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 24px;">🎯</span>
        <div>
          <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--text); letter-spacing: 0.5px;">Demo Showcase & Sandbox Loader</h3>
          <span class="text-xs text-muted" style="display: block; margin-top: 2px;">Pasirinkite: kurti švarų projektą su promptais ComfyUI generavimui ARBA iškart testuoti pilnai sugeneruotą demo!</span>
        </div>
      </div>
      <div style="display: flex; gap: 10px; align-items: center;">
        <button class="btn good" onclick="window.saveCurrentAsDemoPreset()" style="font-size: 12px; padding: 6px 14px; font-weight: 700; border-radius: 8px;" title="Išsaugoti esamą atidarytą projektą su visais vaizdais kaip Demonstracinį Paketą">
          💾 Išsaugoti Esamą Projektą kaip Demo
        </button>
        <button class="btn icon" onclick="window.closeDemoModal()" title="Close (ESC)">✕</button>
      </div>
    </div>

    <div class="modal-b flex-col" style="padding: 24px; gap: 20px; overflow-y: auto; flex: 1;">
      
      <!-- Info banner: 2 Workflow Options -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; padding: 12px 16px;">
        <div style="display: flex; gap: 10px; align-items: flex-start;">
          <span style="font-size: 18px;">🎯</span>
          <div>
            <strong style="font-size: 12px; color: var(--accent);">1. Švarus Demo Šablonas (Starter)</strong>
            <p class="text-xs text-muted" style="margin: 2px 0 0 0; line-height: 1.35;">
              Užkrauna veikėjų/scenų promptus, balso tekstą ir laiko juostą <b>be vaizdų</b>. Sugeneruojate vaizdus su ComfyUI ir jie automatiškai išsisaugo.
            </p>
          </div>
        </div>
        <div style="display: flex; gap: 10px; align-items: flex-start;">
          <span style="font-size: 18px;">🚀</span>
          <div>
            <strong style="font-size: 12px; color: #00ffcc;">2. Pilnas Demo Paketas (Full Ready)</strong>
            <p class="text-xs text-muted" style="margin: 2px 0 0 0; line-height: 1.35;">
              Užkrauna projektą su <b>jau sugeneruotais 1080p kadrais</b>, balsu ir kinetiniais titrais. Galite iškart paleisti Video Studiją ir renderį.
            </p>
          </div>
        </div>
      </div>

      <!-- Section 1: Presets Grid -->
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
          <h4 style="margin: 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); font-weight: 700;">
            🎬 Demonstraciniai Paketai (Presets & Saved Demos)
          </h4>
          <span class="text-xs text-muted">Kiekvienam paketui pasiekiami abu režimai</span>
        </div>

        <div id="demoPresetsContainer" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 16px;">
          <!-- Dynamically populated via demo.js -->
        </div>
      </div>

      <!-- Section 2: Custom Demo Creator -->
      <div style="background: rgba(0, 240, 255, 0.03); border: 1px solid rgba(0, 240, 255, 0.2); border-radius: 12px; padding: 18px 20px;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
          <span style="font-size: 18px;">⚡</span>
          <h4 style="margin: 0; font-size: 14px; color: #fff; font-weight: 700;">Greitas Individualus Demo Generatorius</h4>
        </div>
        <p class="text-xs text-muted" style="margin: 0 0 14px 0; line-height: 1.4;">
          Įveskite bet kokią norimą temą (pvz., <i>„Medieval Dragon Quest“</i>, <i>„Retro Synthwave Racer“</i>, <i>„Smart Home AI Commercial“</i>) ir sistema akimirksniu suformuos 3 scenų demonstracinį projektą su personažu ir kinetiniais titrais.
        </p>

        <div style="display: flex; gap: 10px; align-items: center;">
          <input type="text" id="customDemoTheme" placeholder="Pvz.: Cyberpunk Samurai in Neo-Tokyo" style="flex: 1; padding: 10px 14px; background: rgba(0,0,0,0.5); border: 1px solid var(--border); border-radius: 8px; color: #fff; font-size: 13px;" />
          <button id="btnSubmitCustomDemo" class="btn" style="padding: 10px 20px; font-weight: 800; font-size: 12px; background: linear-gradient(135deg, #00f0ff 0%, #0077ff 100%); color: #000; border: none; border-radius: 8px; white-space: nowrap; cursor: pointer; box-shadow: 0 2px 10px rgba(0, 240, 255, 0.3);">
            ✨ Generuoti Demo
          </button>
        </div>
      </div>

    </div>

    <div class="modal-f flex justify-between items-center" style="border-top: 1px solid var(--border); padding: 12px 24px; background: rgba(18, 22, 34, 0.95);">
      <span class="text-xs text-muted">💡 Patarimas: užkrovus demo galite iškart eiti į <b>9. Video Studio</b> ir paleisti video peržiūrą!</span>
      <button class="btn" onclick="window.closeDemoModal()" style="font-size: 12px; padding: 6px 18px;">Uždaryti</button>
    </div>

  </div>
</div>

<!-- ============================================================================ -->
<!-- SAVE AS DEMO PRESET MODAL                                                    -->
<!-- ============================================================================ -->
<div id="modalSaveAsDemo" class="modal-overlay">
  <div class="modal" style="max-width: 580px; width: 95vw; background: var(--panel); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.85);">
    
    <div class="modal-h" style="padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; background: rgba(20, 26, 40, 0.95);">
      <div style="display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 22px;">💾</span>
        <div>
          <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: var(--text);">Išsaugoti kaip Demo Paketą</h3>
          <span class="text-xs text-muted">Išsaugokite dabartinį projektą ant esamo demo arba kaip naują paketą</span>
        </div>
      </div>
      <button class="btn icon" onclick="window.closeSaveDemoModal()" title="Uždaryti">✕</button>
    </div>

    <div class="modal-b flex-col" style="padding: 20px; gap: 16px;">
      
      <!-- Option Mode Selection (Tabs) -->
      <div style="display: flex; gap: 8px; background: rgba(0,0,0,0.35); padding: 4px; border-radius: 10px; border: 1px solid var(--border);">
        <button id="tabSaveDemoOverwrite" class="btn" style="flex: 1; padding: 8px 12px; font-size: 12px; font-weight: 700; border-radius: 8px; background: var(--accent); color: #000;" onclick="window.switchSaveDemoTab('overwrite')">
          🔄 Perrašyti / Atnaujinti Esamą
        </button>
        <button id="tabSaveDemoNew" class="btn" style="flex: 1; padding: 8px 12px; font-size: 12px; font-weight: 600; border-radius: 8px; background: transparent; color: var(--text);" onclick="window.switchSaveDemoTab('new')">
          ✨ Sukurti Naują Demo
        </button>
      </div>

      <!-- Mode 1: Overwrite Existing Demo -->
      <div id="saveDemoOverwriteArea" style="display: flex; flex-direction: column; gap: 12px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text); margin-bottom: 6px;">
            Pasirinkite kurį Demo paketą perrašyti:
          </label>
          <select id="selectDemoOverwriteTarget" style="width: 100%; padding: 10px 12px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); border-radius: 8px; color: #fff; font-size: 13px;">
            <!-- Dynamically filled with all presets -->
          </select>
          <span id="saveDemoSourceHint" class="text-xs" style="display: block; margin-top: 5px; color: #00f0ff; font-weight: 600;"></span>
        </div>
      </div>

      <!-- Mode 2: Create New Demo -->
      <div id="saveDemoNewArea" style="display: none; flex-direction: column; gap: 12px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text); margin-bottom: 6px;">
            Naujo Demo Paketo Pavadinimas:
          </label>
          <input type="text" id="inputSaveDemoName" placeholder="Pvz.: 🌟 Demo: Mano Cyberpunk Epas" style="width: 100%; padding: 10px 12px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); border-radius: 8px; color: #fff; font-size: 13px;" />
        </div>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text); margin-bottom: 6px;">
            Žanras / Kategorija:
          </label>
          <input type="text" id="inputSaveDemoGenre" placeholder="Pvz.: Sci-Fi / Cyberpunk" value="Custom AI Generation" style="width: 100%; padding: 10px 12px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); border-radius: 8px; color: #fff; font-size: 13px;" />
        </div>
      </div>

      <!-- Common Fields: Description & Badge -->
      <div>
        <label style="display: block; font-size: 12px; font-weight: 700; color: var(--text); margin-bottom: 6px;">
          Aprašymas (Description):
        </label>
        <textarea id="inputSaveDemoDesc" rows="2" placeholder="Trumpas demo aprašymas..." style="width: 100%; padding: 10px 12px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); border-radius: 8px; color: #fff; font-size: 12px; resize: vertical;"></textarea>
      </div>

      <!-- Summary Info Box -->
      <div style="background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 10px 12px; font-size: 11px; color: var(--muted); display: flex; justify-content: space-between; align-items: center;">
        <span id="saveDemoSceneStats">🎬 Scenos: 0 • 👥 Veikėjai: 0</span>
        <span id="saveDemoThumbnailBadge" style="color: #00ffcc;">🖼️ Viršelis: Auto iš kadro</span>
      </div>

    </div>

    <div class="modal-f flex justify-between items-center" style="border-top: 1px solid var(--border); padding: 12px 20px; background: rgba(18, 22, 34, 0.95);">
      <button class="btn" onclick="window.closeSaveDemoModal()" style="font-size: 12px; padding: 7px 16px;">Atšaukti</button>
      <button id="btnConfirmSaveDemoPreset" class="btn good" style="font-size: 12px; padding: 7px 20px; font-weight: 800; border-radius: 8px; display: flex; align-items: center; gap: 6px;" onclick="window.executeSaveAsDemoPreset()">
        💾 Išsaugoti Paketą
      </button>
    </div>

  </div>
</div>