<div id="modalSystemSettings" class="modal-overlay">
  <div class="modal" style="max-width:1200px; width:95vw; height:90vh;">
    <div class="modal-h">System & Render Farm Settings <button class="btn icon" onclick="document.getElementById('modalSystemSettings').classList.remove('show')">✕</button></div>
    <div class="modal-b" style="display:flex; flex-direction:column; gap:20px; overflow-y:auto; padding:20px;">

      <div class="panel" style="margin-bottom:0;">
        <div class="panel-h">Audio Engine (WhisperX)</div>
        <div class="flex items-center">
          <input id="wServerUrl" type="text" value="http://127.0.0.1:8000/" placeholder="http://127.0.0.1:8000/" style="max-width:400px;"/>
          <button class="btn primary" onclick="let v = document.getElementById('wServerUrl').value.trim(); if(v && !v.startsWith('http')) v = 'http://' + v; if(v && !v.endsWith('/')) v += '/'; state.wServerUrl = v; fetch('/api/session', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({wServerUrl: v})}).catch(()=>{}); toast('Saved', 'Whisper URL išsaugotas ir tikrinamas...', 'success');">Save & Ping</button>
        </div>
      </div>

      <div class="panel" style="margin-bottom:0;">
        <div class="panel-h flex justify-between">
          <div>Render Nodes (GPU Farm)</div>
          <button class="btn good text-xs" onclick="if(typeof window.openAddNodeModal === 'function') window.openAddNodeModal();">+ Add New Node</button>
        </div>
        <div id="renderNodesGrid" class="grid-img" style="grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));">
          <div class="text-muted text-sm" style="padding:10px;">Loading nodes...</div>
        </div>
      </div>

      <div class="panel" style="margin-bottom:0; flex:1; display:flex; flex-direction:column; min-height: 300px;">
        <div class="panel-h flex justify-between">
          <div>Live Task Queue</div>
          <button class="btn bad text-xs" onclick="if(typeof window.clearSystemQueue === 'function') window.clearSystemQueue();">🗑️ Clear All Pending</button>
        </div>
        <div style="flex:1; overflow-y:auto; border:1px solid var(--border); border-radius:8px; background:rgba(0,0,0,0.3);">
          <table style="width:100%; border-collapse:collapse; font-size:12px;">
            <thead style="position:sticky; top:0; background:var(--panel2); z-index:10;">
              <tr>
                <th width="15%">Task ID</th>
                <th width="15%">Project</th>
                <th width="15%">Target</th>
                <th width="20%">Assigned GPU</th>
                <th width="20%">Status</th>
                <th width="15%">Actions</th>
              </tr>
            </thead>
            <tbody id="liveQueueTbody">
               <tr><td colspan="6" class="text-center text-muted" style="padding:20px;">Queue is empty</td></tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<div id="modalNodeEdit" class="modal-overlay">
  <div class="modal" style="max-width:500px">
    <div class="modal-h"><span id="nodeEditTitle">Add New GPU Node</span> <button class="btn icon" onclick="document.getElementById('modalNodeEdit').classList.remove('show')">✕</button></div>
    <div class="modal-b flex-col">
      <input type="hidden" id="nodeEditId" />
      <div class="field"><label>Node Name</label><input type="text" id="nodeEditName" placeholder="e.g. RunPod RTX 4090" /></div>
      <div class="field"><label>API URL (ComfyUI)</label><input type="text" id="nodeEditUrl" placeholder="https://...proxy.runpod.net" /></div>
      <div class="field"><label>API Key (Optional)</label><input type="password" id="nodeEditKey" placeholder="Leave empty if none" /></div>
      
      <div class="field">
        <label>Lock to Project (Optional)</label>
        <select id="nodeEditLock">
          <option value="">-- Global Pool (Unlocked) --</option>
          </select>
      </div>
      
      <div class="field mt-2">
        <label class="flex items-center text-sm cursor-pointer text-muted">
          <input type="checkbox" id="nodeEditPaused" /> <span style="margin-left: 6px;">Start Paused (Offline)</span>
        </label>
      </div>
    </div>
    <div class="modal-f" style="justify-content: space-between;">
      <button id="btnDeleteNode" class="btn bad hidden" onclick="if(typeof window.deleteNode === 'function') window.deleteNode();">🗑️ Delete Node</button>
      <button class="btn primary" onclick="if(typeof window.saveNodeConfig === 'function') window.saveNodeConfig();">Save Node</button>
    </div>
  </div>
</div>

<div id="modalSaveVoice" class="modal-overlay">
  <div class="modal" style="max-width:400px">
    <div class="modal-h">Save Voice to Library <button class="btn icon" onclick="document.getElementById('modalSaveVoice').classList.remove('show')">✕</button></div>
    <div class="modal-b flex-col">
      <div class="text-sm text-muted mb-3">Provide a unique name for this voice to save it in your library for future use.</div>
      <div class="field">
          <label>Voice Name</label>
          <input type="text" id="newVoiceName" placeholder="e.g. raspy_old_man" />
      </div>
    </div>
    <div class="modal-f">
      <button id="btnConfirmSaveVoice" class="btn primary">Save & Add to Library</button>
    </div>
  </div>
</div>

<!-- MODAL: AUDIO CHUNKS INSPECTOR & REGENERATOR -->
<div id="modalAudioChunks" class="modal-overlay">
  <div class="modal" style="max-width:960px; width:92vw; height:88vh; display:flex; flex-direction:column;">
    <div class="modal-h" style="padding:14px 20px; background: rgba(16, 23, 35, 0.95); border-bottom: 1px solid var(--border);">
      <div class="flex items-center" style="gap:10px;">
        <span style="font-size: 16px; font-weight: 750;">🎙️ Audio Chunks Inspector & Regenerator</span>
        <span id="modalChunksTotalBadge" class="badge mode text-xs">0 Chunks</span>
      </div>
      <button class="btn icon" onclick="document.getElementById('modalAudioChunks').classList.remove('show')">✕</button>
    </div>
    
    <!-- TOP TOOLBAR -->
    <div style="padding: 12px 20px; background: rgba(0,0,0,0.25); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
      <div class="flex items-center" style="gap: 12px; flex-wrap: wrap;">
        <div class="flex items-center" style="gap: 6px;">
          <span class="text-xs text-muted" style="font-weight: 600;">Voice:</span>
          <select id="chunksModalVoiceSelect" style="max-width: 180px; padding: 4px 8px; font-size: 12px; background: rgba(0,0,0,0.4);">
            <!-- Voices dynamically populated -->
          </select>
        </div>
        <div class="flex items-center" style="gap: 6px;">
          <span class="text-xs text-muted" style="font-weight: 600;">Pause between:</span>
          <input type="number" id="chunksModalSilenceInput" value="300" min="50" max="2000" step="50" style="width: 70px; padding: 4px 8px; font-size: 12px;" />
          <span class="text-xs text-muted">ms</span>
        </div>
        <button id="btnAddChunkInModal" class="btn good text-xs" style="padding: 5px 10px;">➕ Add Sentence</button>
      </div>

      <div class="flex items-center" style="gap: 10px; flex-wrap: wrap;">
        <button id="btnRestitchModalAudio" class="btn primary text-xs" style="padding: 5px 12px;" title="Re-combine all chunk audios into single master track">
          🔄 Re-stitch Master Audio
        </button>
        <audio id="modalMasterAudioPlayer" controls style="height: 28px; width: 180px; outline: none; border-radius: 14px;"></audio>
      </div>
    </div>

    <!-- CHUNKS LIST (SCROLLABLE) -->
    <div class="modal-b" style="flex: 1; overflow-y: auto; padding: 16px 20px; display: flex; flex-direction: column; gap: 14px; background: rgba(11, 15, 20, 0.6);">
      <div id="audioChunksList" style="display: flex; flex-direction: column; gap: 12px;">
        <!-- Dynamically rendered chunk cards -->
      </div>
    </div>

    <!-- FOOTER -->
    <div class="modal-f" style="padding: 12px 20px; background: rgba(16, 23, 35, 0.95); border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
      <div id="modalChunksStatus" class="text-xs text-muted flex items-center" style="gap: 8px;">
        <span>Paruošta redagavimui ir atskiram pergeneravimui.</span>
      </div>
      <div class="flex" style="gap: 10px;">
        <button class="btn text-xs" onclick="document.getElementById('modalAudioChunks').classList.remove('show')">Close</button>
        <button id="btnSaveApplyChunks" class="btn good text-xs" style="padding: 8px 16px; font-weight: bold;">
          💾 Save & Update Timeline
        </button>
      </div>
    </div>
  </div>
</div>

<div id="modalJson" class="modal-overlay">
  <div class="modal" style="max-width:600px">
    <div class="modal-h">Load JSON<button class="btn icon" onclick="$('#modalJson').classList.remove('show')">✕</button></div>
    <div class="modal-b">
      <div class="text-sm text-muted mb-2">Example keys: `id`, `prompt`, `text`, `negative`, `refA`, `refB`, `refC`.</div>
      <textarea id="jsonInput" style="height:250px" spellcheck="false" placeholder='[{"id":"s1", "prompt":"...", "text":"...", "refA":"img1.png"}]'></textarea>
    </div>
    <div class="modal-f">
      <button id="btnApplyJson" class="btn primary">Load</button>
    </div>
  </div>
</div>

<div id="modalCharJson" class="modal-overlay">
  <div class="modal" style="max-width:600px">
    <div class="modal-h">Load Character JSON<button class="btn icon" onclick="$('#modalCharJson').classList.remove('show')">✕</button></div>
    <div class="modal-b">
      <textarea id="charJsonInput" style="height:250px" spellcheck="false"></textarea>
    </div>
    <div class="modal-f">
      <button id="btnApplyCharJson" class="btn primary">Load</button>
    </div>
  </div>
</div>

<div id="modalEdit" class="modal-overlay">
  <div class="modal" style="max-width:760px; width:95vw; max-height:94vh; display:flex; flex-direction:column;">
    <div class="modal-h" style="padding: 12px 18px;">
      <span>Edit Data <span id="eSceneId" class="badge text-xs" style="margin-left:10px"></span></span>
      <button class="btn icon" onclick="window.closeEdit()">✕</button>
    </div>
    <div class="modal-b" style="flex:1; overflow-y:auto; padding:12px 18px; display:flex; flex-direction:column; gap:8px;">
      <div class="field" style="margin-bottom:0;"><label style="font-size:11px; margin-bottom:3px; font-weight:700;">Prompt</label><textarea id="ePrompt" style="height:65px; min-height:45px; font-family:var(--mono); font-size:12px; line-height:1.35; resize:vertical;"></textarea></div>
      <div class="field" style="margin-bottom:0;"><label style="font-size:11px; margin-bottom:3px; font-weight:700;">Script Text</label><textarea id="eText" style="height:40px; min-height:30px; font-size:12px; line-height:1.35; resize:vertical;" readonly></textarea></div>
      <div class="field" style="margin-bottom:0;"><label style="font-size:11px; margin-bottom:3px; font-weight:700;">Negative</label><textarea id="eNeg" style="height:38px; min-height:30px; font-family:var(--mono); font-size:11px; line-height:1.35; resize:vertical;"></textarea></div>
      
      <div style="border-top:1px solid var(--border); margin:2px 0;"></div>
      <div style="display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:10px; margin-bottom:0; width:100%; box-sizing:border-box;">
        <div class="field" style="margin-bottom:0; min-width:0;">
          <label style="margin-bottom:4px; font-size:11px; font-weight:700;">Ref A (Character)</label>
          <input type="hidden" id="eRefA" value="" />
          <div id="eRefSlotADisplay" style="min-width:0; width:100%;"></div>
          <input type="file" id="fileEditRefA" class="hidden" accept="image/*">
        </div>
        <div class="field" style="margin-bottom:0; min-width:0;">
          <label style="margin-bottom:4px; font-size:11px; font-weight:700;">Ref B</label>
          <input type="hidden" id="eRefB" value="" />
          <div id="eRefSlotBDisplay" style="min-width:0; width:100%;"></div>
          <input type="file" id="fileEditRefB" class="hidden" accept="image/*">
        </div>
        <div class="field" style="margin-bottom:0; min-width:0;">
          <label style="margin-bottom:4px; font-size:11px; font-weight:700;">Ref C</label>
          <input type="hidden" id="eRefC" value="" />
          <div id="eRefSlotCDisplay" style="min-width:0; width:100%;"></div>
          <input type="file" id="fileEditRefC" class="hidden" accept="image/*">
        </div>
      </div>
      
      <div style="border-top:1px solid var(--border); margin:2px 0;"></div>
      <div style="display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:10px; margin-bottom:0; width:100%;">
        <div class="field" style="margin-bottom:0; min-width:0;"><label style="font-size:11px; margin-bottom:3px; font-weight:700;">Width</label><input type="number" id="eW" style="font-size:12px; padding:5px 8px; width:100%;"/></div>
        <div class="field" style="margin-bottom:0; min-width:0;"><label style="font-size:11px; margin-bottom:3px; font-weight:700;">Height</label><input type="number" id="eH" style="font-size:12px; padding:5px 8px; width:100%;"/></div>
        <div class="field" style="margin-bottom:0; min-width:0;"><label style="font-size:11px; margin-bottom:3px; font-weight:700;">Steps</label><input type="number" id="eSteps" style="font-size:12px; padding:5px 8px; width:100%;"/></div>
        <div class="field" style="margin-bottom:0; min-width:0;"><label style="font-size:11px; margin-bottom:3px; font-weight:700;">CFG</label><input type="number" id="eCfg" step="0.5" style="font-size:12px; padding:5px 8px; width:100%;"/></div>
      </div>
      <div class="field" style="margin-top:2px; margin-bottom:0;">
        <label class="flex items-center text-xs cursor-pointer text-muted" style="gap:6px;"><input type="checkbox" id="eApplyToScene" checked /> Apply changes to Scene template</label>
      </div>
    </div>
    <div class="modal-f" style="padding:10px 18px;">
      <button id="btnEditSave" class="btn good" style="padding:8px 18px; font-weight:bold; font-size:12px;">Save Only</button>
      <button id="btnEditRegen" class="btn primary" style="padding:8px 18px; font-weight:bold; font-size:12px;">Save & Generate (Ctrl+Enter)</button>
    </div>
  </div>
</div>

<div id="modalCharEdit" class="modal-overlay">
  <div class="modal" style="max-width:600px">
    <div class="modal-h">Edit Character Params <span id="cEditRefName" class="badge text-xs" style="margin-left:10px"></span><button class="btn icon" onclick="window.closeCharEdit()">✕</button></div>
    <div class="modal-b">
      <div class="field mb-2"><label>Prompt</label><textarea id="cPrompt" style="height:80px; font-family:var(--mono)"></textarea></div>
      <div class="field mb-2"><label>Negative Prompt</label><textarea id="cNeg" style="height:40px; font-family:var(--mono)"></textarea></div>
      <div class="grid-wf" style="grid-template-columns:1fr 1fr 1fr; gap:10px">
        <div class="field"><label>Steps</label><input type="number" id="cSteps" disabled/></div>
        <div class="field"><label>CFG</label><input type="number" id="cCfg" step="0.5" disabled/></div>
        <div class="field"><label>Seed</label><input type="number" id="cSeed"/></div>
      </div>
      <div class="field mt-2">
        <label class="flex items-center text-sm cursor-pointer text-muted"><input type="checkbox" id="cRandomize" /> Randomize Seed</label>
      </div>
    </div>
    <div class="modal-f">
      <button id="btnCharEditSave" class="btn good">Save Only</button>
      <button id="btnCharEditRegen" class="btn primary">Save & Generate</button>
    </div>
  </div>
</div>

<div id="modalFurtherEdit" class="modal-overlay">
  <div class="modal" style="max-width:640px; width:94vw; max-height:92vh; display:flex; flex-direction:column;">
    <div class="modal-h" style="padding: 12px 18px;">
      <span>Further Edit <span id="feSceneId" class="badge"></span></span>
      <button class="btn icon" onclick="$('#modalFurtherEdit').classList.remove('show')">✕</button>
    </div>
    <div class="modal-b" style="flex:1; overflow-y:auto; padding:12px 18px; display:flex; flex-direction:column; gap:8px;">
      <!-- Zoomable Image Preview -->
      <div style="width:100%; text-align:center; position:relative; background:rgba(0,0,0,0.5); border-radius:8px; border:1px solid var(--border); overflow:hidden; display:flex; align-items:center; justify-content:center; max-height:210px;">
        <img id="feImgPreview" style="width:100%; max-height:210px; object-fit:contain; cursor:zoom-in; transition:transform 0.15s ease;" title="Spauskite, kad padidintumėte į pilno ekrano režimą" />
      </div>

      <!-- Edit Prompt -->
      <div class="field" style="margin-bottom:0;">
        <label style="font-size:11px; margin-bottom:3px; font-weight:700;">Edit Prompt</label>
        <textarea id="fePrompt" style="height:62px; min-height:45px; font-family:var(--mono); font-size:12px; line-height:1.35; resize:vertical;"></textarea>
      </div>

      <!-- Visual Reference Slots (No clunky dropdowns) -->
      <div style="border-top:1px solid var(--border); margin:2px 0;"></div>
      <div class="grid-wf" style="grid-template-columns: 1fr 1fr; gap:10px;">
        <div class="field" style="margin-bottom:0;">
          <label style="margin-bottom:4px; font-size:11px; font-weight:700;">Add. Ref 1 (Use as B)</label>
          <input type="hidden" id="feRef1" value="" />
          <div id="feRefSlot1Display"></div>
          <input type="file" id="fileFe1" class="hidden" accept="image/*">
        </div>
        <div class="field" style="margin-bottom:0;">
          <label style="margin-bottom:4px; font-size:11px; font-weight:700;">Add. Ref 2 (Use as C)</label>
          <input type="hidden" id="feRef2" value="" />
          <div id="feRefSlot2Display"></div>
          <input type="file" id="fileFe2" class="hidden" accept="image/*">
        </div>
      </div>
    </div>
    <div class="modal-f" style="padding:10px 18px;">
      <button id="btnGenerateEdit" class="btn warn" style="padding:8px 22px; font-weight:bold; font-size:12px;">Generate Edit</button>
    </div>
  </div>
</div>

<!-- MODAL: FULLSCREEN IMAGE LIGHTBOX -->
<div id="modalImageLightbox" class="modal-overlay" style="z-index:4500; background:rgba(5, 7, 12, 0.92); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);" onclick="if(event.target === this) window.closeImageLightbox()">
  <div style="position:relative; max-width:92vw; max-height:92vh; display:flex; flex-direction:column; align-items:center; justify-content:center;">
    <div style="width:100%; display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; padding:0 4px;">
      <span id="lightboxTitle" style="color:#fff; font-weight:700; font-size:14px; text-shadow:0 2px 4px rgba(0,0,0,0.8); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:80vw;"></span>
      <button class="btn icon bad" style="border-radius:50%; width:32px; height:32px; display:flex; align-items:center; justify-content:center; font-size:15px;" onclick="window.closeImageLightbox()" title="Uždaryti (ESC)">✕</button>
    </div>
    <img id="lightboxImg" src="" style="max-width:90vw; max-height:82vh; object-fit:contain; border-radius:10px; box-shadow:0 25px 70px rgba(0,0,0,0.9); border:1px solid rgba(255,255,255,0.12);" />
  </div>
</div>

<!-- MODAL: VISUAL REFERENCE PICKER -->
<div id="modalRefPicker" class="modal-overlay">
  <div class="modal" style="max-width: 920px; width: 92vw; height: 86vh; display: flex; flex-direction: column;">
    <div class="modal-h" style="padding: 14px 20px; background: rgba(16, 23, 35, 0.95); border-bottom: 1px solid var(--border);">
      <div class="flex items-center justify-between" style="width: 100%;">
        <div class="flex items-center" style="gap: 10px;">
          <span style="font-size: 16px; font-weight: 750;">🖼️ Pasirinkite Referencinį Vaizdą (Reference Picker)</span>
          <span id="refPickerTargetBadge" class="badge ready text-xs">Target: Ref A</span>
        </div>
        <button class="btn icon" onclick="document.getElementById('modalRefPicker').classList.remove('show')">✕</button>
      </div>
    </div>
    
    <!-- TOOLBAR (Search, Upload, Shift Hint) -->
    <div style="padding: 12px 20px; background: rgba(0,0,0,0.3); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
      <div class="flex items-center" style="gap: 10px; flex: 1; min-width: 250px;">
        <input type="text" id="refPickerSearch" placeholder="🔍 Ieškoti referencų..." style="padding: 6px 12px; font-size: 12px; flex: 1; max-width: 320px;" />
        <span class="text-xs text-muted">💡 <em>Spauskite su <strong>Shift</strong>, kad pasirinktumėte kelis (Ref A, Ref B, Ref C)</em></span>
      </div>
      <div class="flex items-center" style="gap: 8px;">
        <input type="file" id="refPickerFileInput" class="hidden" accept="image/*" multiple />
        <button class="btn good text-xs" id="btnRefPickerUpload" style="padding: 6px 12px; font-weight: bold;">📤 Įkelti Naują Referencą</button>
      </div>
    </div>

    <!-- REFS GRID -->
    <div class="modal-b" style="flex: 1; overflow-y: auto; padding: 16px 20px; background: rgba(11, 15, 20, 0.7);">
      <div id="refPickerGrid" class="grid-img" style="grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px;">
        <!-- Dynamically rendered visual cards -->
      </div>
    </div>

    <!-- FOOTER -->
    <div class="modal-f" style="padding: 12px 20px; background: rgba(16, 23, 35, 0.95); border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
      <div class="text-xs text-muted" id="refPickerSelectionStatus">Pasirinkta: nėra</div>
      <div class="flex" style="gap: 10px;">
        <button class="btn text-xs" onclick="document.getElementById('modalRefPicker').classList.remove('show')">Atšaukti</button>
        <button id="btnRefPickerApply" class="btn primary text-xs" style="padding: 8px 18px; font-weight: bold;">Pritaikyti</button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL: SCENE & EFFECTS OVERVIEW / BATCH EDITOR -->
<div id="modalSceneOverview" class="modal-overlay">
  <div class="modal" style="max-width: 1200px; width: 95vw; height: 90vh; display: flex; flex-direction: column;">
    <div class="modal-h" style="padding: 14px 20px; background: rgba(16, 23, 35, 0.95); border-bottom: 1px solid var(--border);">
      <div class="flex items-center justify-between" style="width: 100%;">
        <div class="flex items-center" style="gap: 10px;">
          <span style="font-size: 16px; font-weight: 750;">📋 Scenų ir Efektų Suvestinė (Scene & Effects Overview)</span>
          <span id="overviewSceneCountBadge" class="badge mode text-xs">0 Scenų</span>
        </div>
        <button class="btn icon" onclick="document.getElementById('modalSceneOverview').classList.remove('show')">✕</button>
      </div>
    </div>

    <!-- TOOLBAR (Quick filters / batch apply) -->
    <div style="padding: 10px 20px; background: rgba(0,0,0,0.3); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
      <div class="flex items-center" style="gap: 12px; flex-wrap: wrap;">
        <input type="text" id="overviewSearchInput" placeholder="🔍 Ieškoti scenos ar teksto..." style="padding: 5px 10px; font-size: 12px; width: 200px;" />
        <div class="flex items-center" style="gap: 6px;">
          <span class="text-xs text-muted" style="font-weight:600;">Visiems kamera:</span>
          <select id="overviewBatchCamera" style="padding: 4px 8px; font-size: 11px; max-width: 160px;">
            <option value="">-- Pasirinkti --</option>
            <option value="constant_speed">⚡ Constant Zoom-In</option>
            <option value="constant_speed_out">⚡ Constant Zoom-Out</option>
            <option value="cinematic">🎯 Cinematic Zoom</option>
            <option value="zoom_out">🔍 Zoom-Out Reveal</option>
            <option value="zoom_in_out">🔄 Center Pulse</option>
            <option value="pan_left">⬅️ Pan Left</option>
            <option value="pan_right">➡️ Pan Right</option>
            <option value="pan_up">⬆️ Pan Up</option>
            <option value="pan_down">⬇️ Pan Down</option>
            <option value="drift">💫 Drift</option>
            <option value="random">🌀 Random</option>
            <option value="disabled">🚫 Static</option>
          </select>
          <button class="btn text-xs" id="btnApplyBatchCamera">Taikyti visiems</button>
        </div>
        <div class="flex items-center" style="gap: 6px;">
          <span class="text-xs text-muted" style="font-weight:600;">Visiems perėjimas:</span>
          <select id="overviewBatchTransition" style="padding: 4px 8px; font-size: 11px; max-width: 140px;">
            <option value="">-- Pasirinkti --</option>
            <option value="dissolve">🌊 Dissolve</option>
            <option value="cut">✂️ Cut</option>
            <option value="fade_black">🌑 Fade Black</option>
            <option value="fade_white">⚪ Fade White</option>
            <option value="slide_left">⬅️ Slide Left</option>
            <option value="slide_right">➡️ Slide Right</option>
            <option value="smooth_left">💨 Smooth Left</option>
            <option value="wipe_left">🪟 Wipe Left</option>
            <option value="circle_crop">⭕ Circle Crop</option>
            <option value="zoom_in">🔭 Zoom Push</option>
          </select>
          <button class="btn text-xs" id="btnApplyBatchTransition">Taikyti visiems</button>
        </div>
      </div>
    </div>

    <!-- TABLE / CARDS CONTAINER -->
    <div class="modal-b" style="flex: 1; overflow-y: auto; padding: 14px 20px; background: rgba(11, 15, 20, 0.7);">
      <div id="overviewScenesTableWrap" style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
          <thead style="position: sticky; top: 0; background: #131a26; z-index: 5; border-bottom: 2px solid var(--border);">
            <tr>
              <th style="padding: 8px 10px; width: 60px; text-align: center;">Scena</th>
              <th style="padding: 8px 10px; width: 110px; text-align: center;">Vaizdas / Ref</th>
              <th style="padding: 8px 10px; min-width: 200px;">Scenos Tekstas & Promptas</th>
              <th style="padding: 8px 10px; width: 85px; text-align: center;">Trukmė</th>
              <th style="padding: 8px 10px; width: 160px;">Kameros Judėjimas</th>
              <th style="padding: 8px 10px; width: 140px;">Perėjimas į kitą</th>
              <th style="padding: 8px 10px; width: 130px;">Teksto Efektas</th>
            </tr>
          </thead>
          <tbody id="overviewScenesTbody">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- FOOTER -->
    <div class="modal-f" style="padding: 12px 20px; background: rgba(16, 23, 35, 0.95); border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
      <div class="text-xs text-muted" id="overviewStatusMsg">Paruošta redagavimui. Visi pakeitimai automatiškai įsigalios renderinant.</div>
      <div class="flex" style="gap: 10px;">
        <button class="btn text-xs" onclick="document.getElementById('modalSceneOverview').classList.remove('show')">Uždaryti</button>
        <button id="btnOverviewSaveApply" class="btn good text-xs" style="padding: 8px 18px; font-weight: bold;">
          💾 Išsaugoti ir Pritaikyti Renderiui
        </button>
      </div>
    </div>
  </div>
</div>

<div id="modalVars" class="modal-overlay">
  <div class="modal" style="max-width:800px">
    <div class="modal-h">Variations <span id="vSceneTitle" class="badge"></span><button class="btn icon" onclick="$('#modalVars').classList.remove('show')">✕</button></div>
    <div class="modal-b">
      <div class="text-sm text-muted mb-2">Click to set as main. Hover to preview.</div>
      <div id="vGrid" class="vgrid"></div>
    </div>
  </div>
</div>

<!-- ============================================================================ -->
<!-- EFFECTS & TRANSITIONS LIBRARY GALLERY MODAL -->
<!-- ============================================================================ -->
<div id="modalEffectsLibrary" class="modal-overlay">
  <div class="modal" style="max-width:980px; width:94vw; max-height:88vh; display:flex; flex-direction:column; background: #0c0d14; border: 1px solid var(--border); box-shadow: 0 20px 60px rgba(0,0,0,0.8); border-radius: 16px; overflow: hidden;">
    
    <!-- Modal Header with Title & Search -->
    <div class="modal-h flex justify-between items-center" style="border-bottom:1px solid var(--border); padding: 14px 20px; background: rgba(18, 20, 32, 0.95);">
      <div class="flex items-center gap-3">
        <span style="font-size:26px; filter: drop-shadow(0 2px 8px rgba(99,102,241,0.5));">✨🎨</span>
        <div>
          <h3 style="margin:0; font-size:16px; color:#fff; font-weight:800; letter-spacing:0.3px;">Efektų ir Perėjimų Studija</h3>
          <p class="text-xs text-muted" style="margin:0;">Pasirinkite perėjimą ar kameros efektą – peržiūrėkite animuotą pavyzdį ir pritaikykite vienu paspaudimu</p>
        </div>
      </div>
      
      <div class="flex items-center gap-2">
        <input type="text" id="fxSearchInput" placeholder="🔍 Ieškoti efekto..." style="font-size:11px; padding:6px 12px; width:170px; background:rgba(255,255,255,0.06); border:1px solid var(--border); border-radius:6px; color:#fff;" />
        <button class="btn icon" onclick="document.getElementById('modalEffectsLibrary').classList.remove('show')" style="border-radius:6px;">✕</button>
      </div>
    </div>

    <!-- Modal Tab Bar -->
    <div style="display:flex; gap:8px; padding: 10px 20px; background: rgba(0,0,0,0.4); border-bottom: 1px solid var(--border); overflow-x:auto;">
      <button class="btn fx-tab-btn primary text-xs" data-fxtab="fxTabCamera" style="padding: 7px 16px; font-weight:700; border-radius:8px;">🎥 Kameros Judėjimas (Ken Burns)</button>
      <button class="btn fx-tab-btn text-xs" data-fxtab="fxTabTransitions" style="padding: 7px 16px; font-weight:700; border-radius:8px;">🎭 Scenų Perėjimai (Transitions)</button>
      <button class="btn fx-tab-btn text-xs" data-fxtab="fxTabColor" style="padding: 7px 16px; font-weight:700; border-radius:8px;">🎨 Koloristika ir Filtrai</button>
      <button class="btn fx-tab-btn text-xs" data-fxtab="fxTabTitles" style="padding: 7px 16px; font-weight:700; border-radius:8px;">⚡ Tekstai ir Subtitrai</button>
    </div>

    <!-- Modal Content Body -->
    <div class="modal-b" style="flex:1; overflow-y:auto; padding:20px; background: #07080d;">

      <!-- TAB 1: KAMEROS JUDĖJIMAS & KEN BURNS -->
      <div id="fxTabCamera" class="fx-tab-content">
        <div class="flex justify-between items-center mb-2">
          <h4 style="margin:0; color:#a5b4fc; font-size:13px; text-transform:uppercase; letter-spacing:0.05em;">🎥 Kameros Judėjimas (Ken Burns Motion Engine)</h4>
          <span class="text-xs text-muted">Spustelėkite kortelę pasirinkimui</span>
        </div>

        <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap:14px; margin-top:10px;">

          <!-- Constant Speed Linear Zoom -->
          <div class="fx-gallery-card selected" data-category="camera" data-value="constant_speed">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a fx-center-zoom-in">
                <span style="background:rgba(0,0,0,0.6); color:#00ffcc; padding:3px 8px; border-radius:4px; border:1px solid rgba(0,255,200,0.3); font-weight:800;">⚡ Pastovus Greitis</span>
              </div>
            </div>
            <strong style="font-size:13px; color:#fff;">⚡ Constant Uniform Zoom (Pastovus Linijinis Greitis)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Visoms scenoms vienodas artėjimo greitis per sekundę (be sulėtėjimų/pagreitėjimų). Trumpesnė scena priartėja mažiau, ilgesnė – daugiau.</span>
          </div>

          <!-- Center Zoom In -->
          <div class="fx-gallery-card" data-category="camera" data-value="cinematic">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a fx-center-zoom-in">
                <span style="background:rgba(0,0,0,0.5); padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.2);">🎯 Centras (Center Focus)</span>
              </div>
            </div>
            <strong style="font-size:13px; color:#fff;">🎯 Center Zoom In (Glotnus Priartėjimas į Vidurį)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Tikslus ir tolygus kameros judėjimas į patį vaizdo centrą su švelniu sulėtėjimu pabaigoje.</span>
          </div>

          <!-- Center Zoom Out -->
          <div class="fx-gallery-card" data-category="camera" data-value="zoom_out">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a fx-center-zoom-out">
                <span style="background:rgba(0,0,0,0.5); padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.2);">🔍 Tolimas nuo Centro</span>
              </div>
            </div>
            <strong style="font-size:13px; color:#fff;">🔍 Center Zoom Out (Tolimas nuo Vidurio)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Pradžioje vaizdo centras šiek tiek priartintas, o vėliau lėtai tolsta atskleisdamas visą aplinką.</span>
          </div>

          <!-- Center Pulse -->
          <div class="fx-gallery-card" data-category="camera" data-value="zoom_in_out">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a fx-center-pulse">
                <span style="background:rgba(0,0,0,0.5); padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.2);">🔄 Pulsuojantis Centras</span>
              </div>
            </div>
            <strong style="font-size:13px; color:#fff;">🔄 Center Pulse (Priartėjimas ir Tolimas)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Pirmąją scenos pusę kamera švelniai priartėja į centrą, o antrąją pusę grįžta atgal.</span>
          </div>

          <!-- Pan Left -->
          <div class="fx-gallery-card" data-category="camera" data-value="pan_left">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a fx-pan-left">
                <span style="background:rgba(0,0,0,0.5); padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.2);">⬅️ Slinkimas į Kairę</span>
              </div>
            </div>
            <strong style="font-size:13px; color:#fff;">⬅️ Pan Left (Slinkimas į Kairę)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Kamera tolygiai slenka horizontaliai iš dešinės į kairę, atverdama kairiąją kompozicijos pusę.</span>
          </div>

          <!-- Pan Right -->
          <div class="fx-gallery-card" data-category="camera" data-value="pan_right">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a fx-pan-right">
                <span style="background:rgba(0,0,0,0.5); padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.2);">➡️ Slinkimas į Dešinę</span>
              </div>
            </div>
            <strong style="font-size:13px; color:#fff;">➡️ Pan Right (Slinkimas į Dešinę)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Kamera tolygiai slenka horizontaliai iš kairės į dešinę, atverdama dešiniąją kompozicijos pusę.</span>
          </div>

          <!-- Pan Up -->
          <div class="fx-gallery-card" data-category="camera" data-value="pan_up">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a fx-pan-up">
                <span style="background:rgba(0,0,0,0.5); padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.2);">⬆️ Pakilimas į Viršų</span>
              </div>
            </div>
            <strong style="font-size:13px; color:#fff;">⬆️ Pan Up (Pakilimas į Viršų)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Vertikalus kameros pakilimas iš apačios į viršų (Tilt Up). Puikiai tinka portretams ir pastatams.</span>
          </div>

          <!-- Pan Down -->
          <div class="fx-gallery-card" data-category="camera" data-value="pan_down">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a fx-pan-down">
                <span style="background:rgba(0,0,0,0.5); padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.2);">⬇️ Nusileidimas į Apačią</span>
              </div>
            </div>
            <strong style="font-size:13px; color:#fff;">⬇️ Pan Down (Nusileidimas į Apačią)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Vertikalus kameros nusileidimas iš viršaus į apačią (Tilt Down).</span>
          </div>

          <!-- Drift -->
          <div class="fx-gallery-card" data-category="camera" data-value="drift">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a fx-drift">
                <span style="background:rgba(0,0,0,0.5); padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.2);">💫 Įstrižas Dreifas</span>
              </div>
            </div>
            <strong style="font-size:13px; color:#fff;">💫 Cinematic Drift (Švelnus Dreifavimas)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Švelnus kinematografinis įstrižas judesys, suteikiantis kadrų gyvumo ir natūralumo.</span>
          </div>

          <!-- Random Motion -->
          <div class="fx-gallery-card" data-category="camera" data-value="random">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a fx-center-zoom-in" style="background: linear-gradient(135deg, #312e81 0%, #1e1b4b 50%, #4338ca 100%);">
                <span style="background:rgba(0,0,0,0.5); padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.2);">🌀 Automatinė Įvairovė</span>
              </div>
            </div>
            <strong style="font-size:13px; color:#fff;">🌀 Random Smart Motion (Įvairus Judėjimas)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Kiekvienai projekto scenai automatiškai priskiriamas skirtingas kameros judėjimo tipas.</span>
          </div>

          <!-- Static Disabled -->
          <div class="fx-gallery-card" data-category="camera" data-value="disabled">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a" style="background: #181824;">
                <span style="background:rgba(0,0,0,0.5); padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.2);">🚫 Statiškas Kadras</span>
              </div>
            </div>
            <strong style="font-size:13px; color:#fff;">🚫 Statiškas Vaizdas (Ultra Fast)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Vaizdas nejuda. Greičiausias renderinimas be papildomo judesio apdorojimo.</span>
          </div>

        </div>
      </div>

      <!-- TAB 2: SCENŲ PERĖJIMAI (TRANSITIONS) -->
      <div id="fxTabTransitions" class="fx-tab-content hidden">
        <div class="flex justify-between items-center mb-2">
          <h4 style="margin:0; color:#f9a8d4; font-size:13px; text-transform:uppercase; letter-spacing:0.05em;">🎭 Scenų Perėjimai (FFmpeg Xfade Engine)</h4>
          <span class="text-xs text-muted">Animuota perėjimų peržiūra</span>
        </div>

        <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap:14px; margin-top:10px;">

          <!-- Cross Dissolve -->
          <div class="fx-gallery-card selected" data-category="transition" data-value="dissolve">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a">Scena A</div>
              <div class="fx-layer-b fx-dissolve-anim">Scena B</div>
            </div>
            <strong style="font-size:13px; color:#fff;">🌊 Cross Dissolve (Sklandus Susiliejimas)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Klasikinis kino perėjimas. Senas kadras švelniai tirpsta, o naujas tolygiai išryškėja.</span>
          </div>

          <!-- Fade to Black -->
          <div class="fx-gallery-card" data-category="transition" data-value="fade_black">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a">Scena A</div>
              <div class="fx-layer-b fx-fade-black-anim">Scena B</div>
            </div>
            <strong style="font-size:13px; color:#fff;">🌑 Fade to Black (Apsitemdymas per Juodą)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Kadras trumpam užtemsta iki juodos spalvos ir atveria naują sceną. Puikiai tinka dramatinėms pauzėms.</span>
          </div>

          <!-- Fade to White -->
          <div class="fx-gallery-card" data-category="transition" data-value="fade_white">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a">Scena A</div>
              <div class="fx-layer-b fx-fade-white-anim">Scena B</div>
            </div>
            <strong style="font-size:13px; color:#fff;">⚪ Fade to White (Blyksnis per Baltą)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Ryškus baltas šviesos blyksnis tarp kadrų. Sukuria energijos, sapno ar prisiminimo efektą.</span>
          </div>

          <!-- Slide Left -->
          <div class="fx-gallery-card" data-category="transition" data-value="slide_left">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a">Scena A</div>
              <div class="fx-layer-b fx-slide-left-anim">Scena B ➔</div>
            </div>
            <strong style="font-size:13px; color:#fff;">⬅️ Slide Left (Slinkimas į Kairę)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Naujas kadras įvažiuoja iš dešinės pusės ir nustumia senąjį į kairę.</span>
          </div>

          <!-- Slide Right -->
          <div class="fx-gallery-card" data-category="transition" data-value="slide_right">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a">Scena A</div>
              <div class="fx-layer-b fx-slide-right-anim">⬅ Scena B</div>
            </div>
            <strong style="font-size:13px; color:#fff;">➡️ Slide Right (Slinkimas į Dešinę)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Naujas kadras įvažiuoja iš kairės pusės ir nustumia senąjį į dešinę.</span>
          </div>

          <!-- Smooth Slide Left -->
          <div class="fx-gallery-card" data-category="transition" data-value="smooth_left">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a">Scena A</div>
              <div class="fx-layer-b fx-slide-left-anim" style="filter: blur(1px);">Scena B 💨</div>
            </div>
            <strong style="font-size:13px; color:#fff;">💨 Smooth Slide Left (Glotnus Slydimas)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Minkštas ir itin glotnus kadro įslydimas su lengvu kraštų išsiliejimu.</span>
          </div>

          <!-- Wipe Left -->
          <div class="fx-gallery-card" data-category="transition" data-value="wipe_left">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a">Scena A</div>
              <div class="fx-layer-b fx-wipe-left-anim">Scena B</div>
            </div>
            <strong style="font-size:13px; color:#fff;">🪟 Wipe Left (Uždangos Nuvalymas)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Naujas kadras atsidengia tiesia linija, tarsi nuvalant ankstesnį vaizdą.</span>
          </div>

          <!-- Circle Iris Crop -->
          <div class="fx-gallery-card" data-category="transition" data-value="circle_crop">
            <span class="fx-active-tag">✓ Pasirinkta</span>
            <div class="fx-preview-box">
              <div class="fx-layer-a">Scena A</div>
              <div class="fx-layer-b fx-circle-iris-anim">⭕ Scena B</div>
            </div>
            <strong style="font-size:13px; color:#fff;">⭕ Circle Iris Crop (Apskritimo Perėjimas)</strong>
            <span style="color:var(--muted); font-size:11px; line-height:1.35;">Apskritimo formos objektyvo atsidarymas/užsidarymas iš centro.</span>
          </div>

          <!-- Radial Wipe -->
