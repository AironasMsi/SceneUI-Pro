<!-- 🎬 DAVINCI RESOLVE EXPORT PROGRESS & RESULT MODAL -->
<!-- ========================================================================= -->
<div id="modalDavinciProgress" class="modal-overlay">
  <div class="modal" style="max-width: 580px; width: 92vw; border: 1px solid rgba(236, 72, 153, 0.4); box-shadow: 0 20px 60px rgba(0,0,0,0.8), 0 0 30px rgba(236, 72, 153, 0.2); background: #0c0d16; border-radius: 14px; overflow: hidden;">
    
    <div class="modal-h flex justify-between items-center" style="background: linear-gradient(90deg, rgba(236,72,153,0.15) 0%, rgba(139,92,246,0.15) 100%); border-bottom: 1px solid var(--border); padding: 14px 18px;">
      <div class="flex items-center" style="gap: 10px;">
        <span style="font-size: 20px;">🎬</span>
        <span style="font-weight: 800; font-size: 15px; color: #fff;">DaVinci Resolve Projekto Paketas</span>
      </div>
      <button id="btnDavinciProgressClose" class="btn icon" style="font-size: 14px; padding: 2px 6px;" onclick="document.getElementById('modalDavinciProgress').classList.remove('show');">✕</button>
    </div>

    <div class="modal-b flex-col" style="padding: 20px; gap: 16px;">
      
      <!-- Status Badge & Title -->
      <div class="flex justify-between items-center">
        <div>
          <h4 id="davinciModalStatusTitle" style="margin: 0; font-size: 15px; color: #fff; font-weight: 700;">⏳ Generuojamas ZIP paketas...</h4>
          <span id="davinciModalStatusSub" class="text-xs text-muted" style="margin-top: 3px; display: block;">Ruošiami XML failai, medija su perėjimų buferiais ir Whisper laiko žymos...</span>
        </div>
        <span id="davinciModalPercent" class="mono" style="font-size: 16px; font-weight: 800; color: #ec4899;">15%</span>
      </div>

      <!-- Animated Progress Bar -->
      <div style="height: 10px; background: rgba(255,255,255,0.08); border-radius: 6px; overflow: hidden; position: relative;">
        <div id="davinciModalProgressBar" style="width: 15%; height: 100%; background: linear-gradient(90deg, #ec4899 0%, #8b5cf6 50%, #00ffcc 100%); transition: width 0.35s ease; border-radius: 6px;"></div>
      </div>

      <!-- Real-time Step Log List -->
      <div id="davinciModalSteps" style="background: rgba(0,0,0,0.35); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; font-size: 12px;">
        <div id="dStep1" class="flex items-center text-muted" style="gap: 8px;"><span class="dot" style="background:#f59e0b;"></span> 1. Tikrinama projekto struktūra ir Whisper laiko žymos...</div>
        <div id="dStep2" class="flex items-center text-muted" style="gap: 8px;"><span class="dot" style="background:#555;"></span> 2. Suvedami AI vaizdai ir paruošiami 1000 kadrų buferiai (Handles)...</div>
        <div id="dStep3" class="flex items-center text-muted" style="gap: 8px;"><span class="dot" style="background:#555;"></span> 3. Generuojami FCP 7 XML, SRT subtitrai ir DaVinci Resolve žymekliai...</div>
        <div id="dStep4" class="flex items-center text-muted" style="gap: 8px;"><span class="dot" style="background:#555;"></span> 4. Suspaudžiama į ZIP archyvą ir pradedamas atsisiuntimas...</div>
      </div>

      <!-- Completion Box (Hidden by default, shown on finish) -->
      <div id="davinciModalSuccessBox" class="hidden" style="background: rgba(0, 255, 204, 0.06); border: 1px solid rgba(0, 255, 204, 0.3); border-radius: 8px; padding: 12px 14px; font-size: 12px;">
        <div class="flex items-center justify-between">
          <span style="font-weight: 700; color: #00ffcc;">✅ Archyvas sėkmingai sukurtas!</span>
          <a id="davinciDirectDownloadLink" href="#" class="btn primary text-xs" style="padding: 4px 10px; font-weight: 800; background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%); border: none;">⬇️ Atsisiųsti ZIP vėl</a>
        </div>
        <p class="text-muted text-xs" style="margin: 8px 0 0 0; line-height: 1.4;">
          <strong>Kaip atidaryti:</strong> Išskleiskite ZIP ir DaVinci Resolve spauskite <code>File ➔ Import ➔ Timeline...</code> ir pasirinkite <code>timeline.xml</code>.
        </p>
      </div>

    </div>

    <div class="modal-f flex justify-end items-center" style="border-top: 1px solid var(--border); padding: 10px 18px; background: rgba(18, 20, 32, 0.95);">
      <button class="btn" onclick="document.getElementById('modalDavinciProgress').classList.remove('show');" style="font-size: 12px; padding: 6px 16px;">Uždaryti</button>
    </div>

  </div>
</div>

